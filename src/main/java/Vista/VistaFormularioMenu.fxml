         <image>
            <Image url="@../imagenes/fondo.jpg" />
         </image>
      </ImageView>
      <Label layoutX="87.0" layoutY="58.0" prefHeight="60.0" prefWidth="339.0" style="-fx-background-color: #00FFFF; -fx-border-color: #F42682; -fx-border-width: 3;" text="     GESTIÓN MENÚ" textAlignment="CENTER">
         <font>
            <Font size="33.0" />
         </font>
      </Label>
      <Label layoutX="87.0" layoutY="193.0" prefHeight="31.0" prefWidth="134.0" style="-fx-background-color: #00FFFF; -fx-border-color: #F42682; -fx-border-width: 2;" text="     NOMBRE" textAlignment="CENTER">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="87.0" layoutY="267.0" prefHeight="31.0" prefWidth="134.0" style="-fx-background-color: #00FFFF; -fx-border-color: #F42682; -fx-border-width: 2;" text="  DESCRIPCIÓN" textAlignment="CENTER">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="87.0" layoutY="448.0" prefHeight="25.0" prefWidth="134.0" style="-fx-background-color: #00FFFF; -fx-border-color: #F42682; -fx-border-width: 2;" text="       PRECIO" textAlignment="CENTER">
