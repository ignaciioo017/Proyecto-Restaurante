      </ImageView>
      <ImageView fitHeight="92.0" fitWidth="100.0" layoutX="23.0" layoutY="12.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../imagenes/LogoRestaurante.png" />
         </image>
      </ImageView>
      <ImageView fitHeight="102.0" fitWidth="375.0" layoutX="115.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
