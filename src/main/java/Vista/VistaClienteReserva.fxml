      </ImageView>
      <ImageView fx:id="volver" fitHeight="42.0" fitWidth="94.0" layoutX="23.0" layoutY="129.0" onMouseClicked="#irAVistaPrincipalCliente" onMouseEntered="#agrandarImagen" onMouseExited="#restaurarImagen" pickOnBounds="true" preserveRatio="true">
